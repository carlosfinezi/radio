# Template nginx HTTPS do HestiaCP — Web Rádio.
# Instalar em: /usr/local/hestia/data/templates/web/nginx/php-fpm/webradio.stpl
#
# O par HTTP fica em webradio.tpl (com o bloco do desafio ACME).
# NÃO gerar um a partir do outro por sed: foi assim que o Let's Encrypt quebrou.
# As variáveis %ip%, %domain%, %ssl_pem% etc. são substituídas pelo Hestia.

server {
    listen      %ip%:%web_ssl_port% ssl;
    server_name %domain_idn% %alias_idn%;

    ssl_certificate     %ssl_pem%;
    ssl_certificate_key %ssl_key%;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Uploads de mídia do Auto DJ: um álbum WAV passa fácil de 500 MB.
    client_max_body_size 2048m;

    # ─────────────────────────────────────────────────────────────────
    # Stream contínuo (MP3/AAC)
    # ─────────────────────────────────────────────────────────────────
    # Vai para o AzuraCast (8081), NÃO direto para o Icecast (8005).
    #
    # O mount no Icecast chama-se apenas `/radio.mp3`; quem traduz
    # `/listen/{estacao}/{mount}` para o mount certo é o nginx interno do
    # AzuraCast. Apontar para o Icecast com `proxy_pass .../` reescrevia a
    # URL para `/porto_do_capim/radio.mp3`, que não existe lá: 404 no
    # endpoint público com a rádio tocando perfeitamente por dentro.
    #
    # Sem barra final no proxy_pass: preserva o caminho original.
    location /listen/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;

        # CRÍTICO. Com buffering ligado o nginx acumula o áudio antes de
        # repassar, o que introduz atraso de dezenas de segundos e faz o
        # player estourar o buffer. Um stream infinito NUNCA pode ser
        # bufferizado por proxy.
        proxy_buffering off;
        proxy_request_buffering off;

        # Um ouvinte fica horas conectado; o padrão de 60s cortaria a cada minuto.
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # NÃO adicionar Access-Control-Allow-Origin aqui.
        # O nginx interno do AzuraCast já envia esse cabeçalho. Somando o
        # nosso, a resposta saía com "Access-Control-Allow-Origin: *, *" —
        # valor inválido que o navegador rejeita, quebrando exatamente o
        # player embutido em site de terceiro que a alínea (c) exige.
    }

    # ─────────────────────────────────────────────────────────────────
    # HLS — é o que sustenta "ouvintes ilimitados" (alínea d)
    # ─────────────────────────────────────────────────────────────────
    location /hls/ {
        proxy_pass http://127.0.0.1:8081/hls/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # O manifesto muda a cada segmento; os segmentos são imutáveis.
        # Cachear o .m3u8 congelaria a rádio no passado.
        location ~ \.m3u8$ {
            proxy_pass http://127.0.0.1:8081;
            add_header Cache-Control 'no-cache, no-store, must-revalidate' always;
        }
        location ~ \.(aac|ts|mp4|m4s)$ {
            proxy_pass http://127.0.0.1:8081;
            # Segmento nomeado nunca muda de conteúdo -> cacheável de verdade.
            # É isto que permite ao CDN/edge absorver a escala.
            add_header Cache-Control 'public, max-age=31536000, immutable' always;
        }
    }

    # ─────────────────────────────────────────────────────────────────
    # Painel administrativo + API (alíneas f e g)
    # ─────────────────────────────────────────────────────────────────
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;

        # O painel usa WebSocket para o "tocando agora" em tempo real.
        # `Connection "upgrade"` fixo quebraria keep-alive em toda requisição
        # normal. Repassando $http_upgrade, o cabeçalho é omitido quando
        # vazio e só vira "upgrade" no handshake de WebSocket. (O ideal seria
        # um `map` em contexto http, que o template do Hestia não comporta.)
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $http_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 3600s;
    }

    include %home%/%user%/conf/web/%domain%/nginx.ssl.conf_*;
}
